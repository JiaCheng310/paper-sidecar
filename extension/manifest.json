{
  "manifest_version": 3,
  "name": "Paper Sidecar",
  "version": "0.1.0",
  "description": "在 alphaXiv / arXiv 论文页旁与 AI 一起读论文：支持 ChatGPT 账号及 DeepSeek、Claude 等 API，直接读取 PDF 原文。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "sidePanel", "storage"],
  "host_permissions": [
    "https://alphaxiv.org/*",
    "https://www.alphaxiv.org/*",
    "https://arxiv.org/*",
    "https://www.arxiv.org/*"
  ],
  "action": {
    "default_title": "打开 Paper Sidecar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon.svg"],
      "matches": [
        "https://alphaxiv.org/*",
        "https://www.alphaxiv.org/*",
        "https://arxiv.org/*",
        "https://www.arxiv.org/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://alphaxiv.org/*",
        "https://www.alphaxiv.org/*",
        "https://arxiv.org/*",
        "https://www.arxiv.org/*"
      ],
      "js": ["reader-view.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
